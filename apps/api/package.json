{
  "name": "api.dionysus.club",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "dev": "nodemon -r tsconfig-paths/register src/index.ts",
    "clear": "shx rm -r ./dist",
    "build": "tsup",
    "build:clean": "pnpm clear && pnpm build",
    "start": "cross-env NODE_PATH=dist node dist/index.js",
    "tsc": "tsc --noEmit",
    "db:pull": "drizzle-kit introspect && pnpm db:pull:after",
    "db:pull:after": "prettier ./db/migrations -w",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migr": "drizzle-kit migrate",
    "db:seed": "tsx ./db/seed.ts",
    "db:test": "tsx ./db/test.ts",
    "db:check": "drizzle-kit check",
    "migr:gen": "drizzle-kit generate",
    "migr:gen:mty": "drizzle-kit generate --custom",
    "migr:drop": "drizzle-kit drop",
    "prettier": "prettier . --write"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@kinde-oss/kinde-typescript-sdk": "^2.15.1",
    "@repo/dtos": "workspace:^",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.7",
    "pg": "^8.23.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "nodemon": "^3.1.14",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
